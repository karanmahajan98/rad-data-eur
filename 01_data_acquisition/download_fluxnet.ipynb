0	"# Filter the data using European country codes and for the time range 2001-2020\n"
1	"\n"
2	"european_country_codes = {\n"
3	'    "AT","BE","BG","CH","CZ","DE","DK","EE","ES","FI","FR","GB","GR",\n'
4	'    "HR","HU","IE","IS","IT","LT","LU","LV","NL","NO","PL","PT","RO",\n'
5	'    "SE","SI","SK","BE_g" \n'
6	"}\n"
7	"\n"
8	'catalog["country_code"] = catalog["site_id"].str.split("-").str[0]\n'
9	"\n"
10	'is_european = catalog["country_code"].isin(european_country_codes)\n'
11	'overlaps_period = (catalog["first_year"] <= 2020) & (catalog["last_year"] >= 2001)\n'
12	"\n"
13	"eu_catalog = catalog[is_european & overlaps_period].copy()\n"
14	"\n"
15	'print(f"European sites with data overlapping 2001-2020: {len(eu_catalog)}")\n'
16	'eu_catalog[["site_id", "site_name", "first_year", "last_year"]]'
